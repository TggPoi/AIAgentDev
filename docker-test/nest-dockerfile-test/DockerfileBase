FROM node:22-alpine
#使用node:24.15-alpine会在[auth] library/node:pull token for registry-1.docker.io 拉取镜像时失败

WORKDIR /app

COPY package*.json ./

RUN npm config set registry https://registry.npmmirror.com/
RUN npm install
RUN npm install -g @nestjs/cli

COPY . .

RUN npm run build

EXPOSE 3000

CMD ["node", "dist/main.js"]