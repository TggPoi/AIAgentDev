      "width": 600,
      "height": 40,
      "strokeColor": "#666666",
      "backgroundColor": "#ffffff",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "roughness": 1,
      "opacity": 100,
      "fontSize": 14,
      "fontFamily": 5,
      "text": "如何运行 demo：npm run dev && 访问 http://localhost:3000",
