{
  "name": "react-agent-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "contracts:generate": "openapi-typescript contracts/backend-openapi.json -o src/api/generated/backend-schema.ts",
    "contracts:check": "node scripts/check-generated-contract.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint --deny-warnings .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm contracts:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
